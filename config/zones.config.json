{
  "$schema": "./zones.schema.json",
  "version": "1.0.0",
  "mithorRepoRootEnv": "MITHOR_REPO_PATH",
  "defaultBaseBranch": "develop",
  "zeroAiAttribution": {
    "enforce": true,
    "forbiddenPatterns": [
      "Co-authored-by:",
      "Generated by",
      "Generated with",
      "Claude",
      "DeepSeek",
      "Antigravity",
      "🤖"
    ]
  },
  "zones": {
    "green_ui": {
      "access": "read_write",
      "paths": [
        "apps/FEP/src/**",
        "apps/FEP/public/**"
      ],
      "excludedPaths": [
        "apps/FEP/src/api/**",
        "apps/FEP/src/lib/firebase.js",
        "apps/FEP/src/context/AuthContext.jsx",
        "apps/FEP/src/repositories/**",
        "apps/FEP/src/admin/**"
      ],
      "i18nParityFiles": [
        "apps/FEP/src/locales/de.json",
        "apps/FEP/src/locales/en.json",
        "apps/FEP/src/locales/fr.json"
      ],
      "requiredGates": [
        "fep_build",
        "fep_test",
        "visual_snapshot"
      ]
    },
    "yellow_ide_math": {
      "access": "guarded_write",
      "paths": [
        "apps/AI/app/modules/ide/constants.py",
        "apps/AI/app/modules/ide/parameters.py",
        "apps/AI/app/modules/ide/normalize.py",
        "apps/AI/app/modules/ide/audit.py",
        "apps/AI/app/modules/ide/scoring.py",
        "apps/AI/app/modules/ide/rules.py",
        "apps/AI/app/modules/ide/pricing.py",
        "apps/AI/app/modules/ide/dcf.py",
        "apps/AI/app/modules/ide/residual.py",
        "apps/AI/app/modules/ide/ratings.py",
        "apps/AI/app/modules/ide/report.py"
      ],
      "excludedPaths": [
        "apps/AI/app/modules/ide/routes.py",
        "apps/AI/app/modules/ide/service.py",
        "apps/AI/app/modules/ide/extraction.py",
        "apps/AI/app/modules/ide/market.py",
        "apps/AI/app/modules/ide/__init__.py"
      ],
      "requiredGates": [
        "ide_pytest_golden",
        "bff_ai_contract_check"
      ],
      "requireGermanExplanationBeforeEdit": true,
      "requireExplicitUserConfirmation": true
    },
    "red_locked": {
      "access": "blocked",
      "paths": [
        "apps/BFF/**",
        "apps/Mobile/**",
        "apps/Jobs/**",
        "apps/AI/app/core/**",
        "apps/AI/app/clients/**",
        "apps/AI/app/modules/ide/routes.py",
        "apps/AI/app/modules/ide/service.py",
        "apps/AI/app/modules/ide/extraction.py",
        "apps/AI/app/modules/ide/market.py",
        "apps/AI/app/modules/ide/schemas/**",
        "apps/FEP/src/api/**",
        "apps/FEP/src/lib/firebase.js",
        "apps/FEP/src/context/AuthContext.jsx",
        "apps/FEP/src/repositories/**",
        "apps/FEP/src/admin/**",
        "servers/**",
        "docs/**",
        "scripts/**",
        "Assets/**",
        "devlocal/**",
        ".claude/**",
        ".github/**",
        "**/.env*",
        "**/package.json",
        "**/package-lock.json",
        "**/pnpm-lock.yaml",
        "**/pyproject.toml",
        "**/poetry.lock",
        "**/Dockerfile*",
        "**/docker-compose*.yml",
        "**/vite.config.*"
      ],
      "escalationMessageDe": "Sicherheitshinweis: Dieser Bereich gehört zur geschützten Kern-Infrastruktur (BFF, Datenbank, Authentifizierung, Server oder API-Verträge). Ich habe keine Datei verändert. Bitte gib Sarbu oder Manish kurz Bescheid, damit sie diese Änderung sicher für dich umsetzen."
    }
  },
  "gates": {
    "fep_build": {
      "type": "shell",
      "description": "Vite 6 production bundle check for apps/FEP",
      "cwd": "apps/FEP",
      "command": "npm run build",
      "timeoutMs": 60000
    },
    "fep_test": {
      "type": "shell",
      "description": "Vitest unit, component, PDF export, and i18nParity test suite for apps/FEP",
      "cwd": "apps/FEP",
      "command": "npm test",
      "timeoutMs": 60000
    },
    "visual_snapshot": {
      "type": "mcp_tool",
      "description": "Playwright before/after visual diff on touched apps/FEP views",
      "server": "mithor-visual-preview",
      "tool": "capture_and_diff"
    },
    "ide_pytest_golden": {
      "type": "shell",
      "description": "Deterministic Python IDE unit & golden case regression suite (Hohetorstraße, Clayallee 18, Frankfurter Allee)",
      "cwd": "apps/AI",
      "command": "poetry run pytest tests/unit/ide -q",
      "timeoutMs": 45000
    },
    "bff_ai_contract_check": {
      "type": "internal_contract_validator",
      "description": "Verifies top-level function signatures and Pydantic model fields in apps/AI/app/modules/ide/ match BFF contract expectations"
    }
  },
  "prRiskTiers": [
    {
      "level": "L1",
      "tag": "[L1: PIXEL / COPY]",
      "scope": "CSS, Tailwind classes, spacing, layout styling, or locale text strings (de/en/fr) in apps/FEP",
      "reviewers": ["sarbu"],
      "matchPaths": [
        "apps/FEP/src/**/*.css",
        "apps/FEP/src/locales/*.json",
        "apps/FEP/src/components/**/*.jsx",
        "apps/FEP/src/pages/**/*.jsx"
      ]
    },
    {
      "level": "L2",
      "tag": "[L2: UI LOGIC / PDF]",
      "scope": "React state/props logic, DealCheck/Valuation tables, formatters, or exportValuationPdf.js in apps/FEP",
      "reviewers": ["sarbu", "manish"],
      "matchPaths": [
        "apps/FEP/src/utils/exportValuationPdf.js",
        "apps/FEP/src/utils/exportProjectPdf.js",
        "apps/FEP/src/utils/formatters.js",
        "apps/FEP/src/pages/project/sections/valuation/**",
        "apps/FEP/src/pages/project/sections/dealCheck/**"
      ]
    },
    {
      "level": "L3",
      "tag": "[L3: IDE FORMULA]",
      "scope": "Valuation math, DCF/Residual assumptions, weights, constants, or rules R-01..R-08 in apps/AI/app/modules/ide/*.py",
      "reviewers": ["sarbu", "manish", "ukarky"],
      "matchPaths": [
        "apps/AI/app/modules/ide/*.py"
      ]
    },
    {
      "level": "L4",
      "tag": "[L4: SCHEMA / HIGH RISK]",
      "scope": "Function signatures, Pydantic response fields, cross-app touchpoints (FEP + AI in same branch), or API contract boundaries",
      "reviewers": ["ukarky", "sarbu", "manish"],
      "matchPaths": [
        "apps/AI/app/modules/ide/schemas/**"
      ]
    }
  ]
}
